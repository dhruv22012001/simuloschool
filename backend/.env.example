# Copy to .env for local development. All values below are the local
# docker-compose defaults; prod values are set in Render / GitHub Secrets.

APP_ENV=local

# --- Database (Postgres only; local = docker-compose, prod = Neon) ---
DATABASE_URL=postgresql+psycopg://simulo:simulo@localhost:5432/simuloschool

# --- Auth ---
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# --- Admin bootstrap (seeded idempotently at startup; never hardcode) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# --- CORS (comma-separated allowed origins; local = the static server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# --- Quiz generation (Claude) + transcription (Whisper) ---
# Required by `python -m app.jobs.generate`; the API itself runs without them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
GENERATE_BATCH_SIZE=5

# --- Object storage (local = MinIO from docker-compose, prod = Cloudflare R2) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=videos
S3_REGION=auto
